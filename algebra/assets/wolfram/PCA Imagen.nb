      RowBox[{"covM", ".", "W"}], "-", 
      RowBox[{"W", ".", 
       RowBox[{"DiagonalMatrix", "[", "lambdas", "]"}]}]}], "]"}], ",", 
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", "W", "]"}], ".", "W"}], "-", 

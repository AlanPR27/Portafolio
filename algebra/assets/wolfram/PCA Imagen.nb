   RowBox[{"Eigensystem", "[", "covM", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"orden", "=", 
   RowBox[{"Ordering", "[", 
    RowBox[{"lambdas", ",", "All", ",", "Greater"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lambdas", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"lambdas", "[", 
     RowBox[{"[", "orden", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"W", "=", 
    RowBox[{"Transpose", "[", 
